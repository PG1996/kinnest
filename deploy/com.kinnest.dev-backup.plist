<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Install: copy to ~/Library/LaunchAgents/, replace REPO_DIR and HOME_DIR, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kinnest.dev-backup.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kinnest.dev-backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>REPO_DIR/deploy/backup-dev.sh</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME_DIR/kinnest-backups/dev/backup.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/kinnest-backups/dev/backup.log</string>
</dict>
</plist>
