# Dev uses kinnest/kinnest. In production use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://kinnest:kinnest@db:5432/kinnest
SESSION_SECRET=change-me
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465  (empty = log mails to the console in dev)
SMTP_URL=
# production: https://<PUBLIC_HOST>  (also turns on secure cookies)
PUBLIC_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# --- real-use stack (deploy/docker-compose.prod.yml) ---
# Mac behind a tunnel:  PUBLIC_HOST=:80  CADDY_HTTP_PORT=8080.  Hosted VM: PUBLIC_HOST=kinnest.duckdns.org
PUBLIC_HOST=:80
CADDY_HTTP_PORT=8080
POSTGRES_PASSWORD=change-me
# Backups: # Mac: BACKUP_TARGET=local:$HOME/kinnest-backups   Hosted: BACKUP_TARGET=s3
BACKUP_TARGET=local:/tmp/kinnest-backups with these, or BACKUP_TARGET=local:/path
# Mac: BACKUP_TARGET=local:$HOME/kinnest-backups   Hosted: BACKUP_TARGET=s3
BACKUP_TARGET=local:/tmp/kinnest-backups
BACKUP_BUCKET=
BACKUP_ENDPOINT=
