# Dev uses kinnest/kinnest. In production use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://kinnest:kinnest@db:5432/kinnest
SESSION_SECRET=change-me
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465  (empty = log mails to the console in dev)
SMTP_URL=
# production: https://<PUBLIC_HOST>  (also turns on secure cookies)
PUBLIC_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# --- real-use stack (deploy/docker-compose.prod.yml) ---
# Optional services: worker (reminders) and ngrok (public tunnel on the VM). Mac: worker. AWS VM: worker,ngrok
COMPOSE_PROFILES=worker
# Mac behind a tunnel:  PUBLIC_HOST=:80  CADDY_HTTP_PORT=8080.  AWS VM: PUBLIC_HOST=:80 (ngrok adds HTTPS)
PUBLIC_HOST=:80
CADDY_HTTP_PORT=8080
POSTGRES_PASSWORD=change-me
# AWS VM only (profile ngrok)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Backups. Mac: BACKUP_TARGET=local:$HOME/kinnest-backups   AWS: BACKUP_TARGET=s3 with BACKUP_BUCKET
# (BACKUP_ENDPOINT only for non-AWS S3-compatible storage)
BACKUP_TARGET=local:/tmp/kinnest-backups
BACKUP_BUCKET=
BACKUP_ENDPOINT=
